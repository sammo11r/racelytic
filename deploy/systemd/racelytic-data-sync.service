[Unit]
Description=Refresh and atomically publish Racelytic race data
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/racelytics
EnvironmentFile=/var/www/racelytics/.env
ExecStart=/usr/local/bin/node scripts/sync-data.js
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=3h

# Restrict the updater while allowing its working data and database connection.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/racelytics/data
