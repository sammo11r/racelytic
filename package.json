{
  "name": "racelytic",
  "version": "1.0.0",
  "private": true,
  "description": "Independent multi-series motorsport archive, analysis and simulation platform.",
  "main": "backend/server.js",
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://racelytic.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/sammo11r/racelytic.git"
  },
  "bugs": {
    "url": "https://github.com/sammo11r/racelytic/issues"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "build:frontend": "node scripts/build-frontend.js",
    "consolidate:css": "node scripts/consolidate-css.js",
    "import": "node backend/import/all.js",
    "import:formula-e": "node backend/import/all.js --series=fe",
    "import:wec": "node backend/import/all.js --series=wec",
    "postimport": "npm run rebuild:ratings",
    "sync:data": "node scripts/sync-data.js",
    "sync:data:dry": "node scripts/sync-data.js --dry-run",
    "sync:data:status": "node scripts/sync-data.js --status",
    "seed:community": "node scripts/seed-community.js",
    "rebuild:ratings": "node scripts/rebuild-ratings.js",
    "evaluate:ratings": "node scripts/evaluate-ratings.js",
    "audit:ratings": "node scripts/audit-rating-events.js",
    "audit:rating-identities": "node scripts/audit-rating-identities.js",
    "generate:social-card": "node scripts/generate-social-card.js",
    "generate:ask-answers": "node scripts/generate-ask-answers.js",
    "import:f2-results": "node scripts/import-f2-results.js",
    "import:f2-standings": "node scripts/import-f2-standings.js",
    "collect:f3": "node scripts/collect-f3-data.js",
    "collect:academy": "node scripts/collect-academy-data.js",
    "collect:formula-e": "node scripts/collect-formula-e-data.js",
    "collect:formula-e:history": "node scripts/collect-formula-e-data.js --seasons=1-12",
    "collect:wec": "node scripts/collect-wec-data.js",
    "build:formula-e-circuits": "node scripts/run-formula-e-circuit-builder.js",
    "import:replay:telemetry": "python scripts/import-telemetry-replay.py",
    "compact:replays": "node scripts/compact-replays.js",
    "check:replays": "node scripts/check-replays.js",
    "audit:f3": "node scripts/audit-f3-data.js --series=f3",
    "audit:f2": "node scripts/audit-f3-data.js --series=f2",
    "audit:academy": "node scripts/audit-f3-data.js --series=academy",
    "audit:formula-e": "node scripts/audit-formula-e-data.js",
    "audit:wec": "node scripts/audit-wec-data.js",
    "audit:accessibility": "node scripts/audit-accessibility.js",
    "repair:data": "node scripts/repair-f1-2026-calendar.js && node scripts/repair-junior-data.js",
    "check": "node scripts/build-frontend.js --check && node scripts/consolidate-css.js --check && node scripts/check-replays.js && node scripts/audit-constructor-lineage.js && node scripts/check.js",
    "audit:constructor-lineage": "node scripts/audit-constructor-lineage.js",
    "audit:constructor-lineage:report": "node scripts/audit-constructor-lineage.js --json",
    "test": "node --test"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "csv-parser": "^3.2.1",
    "d3": "^7.9.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mariadb": "^3.4.5",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "^1.62.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "axe-core": "^4.10.3"
  }
}
