{
  "name": "racelytic",
  "version": "1.0.0",
  "private": true,
  "description": "Formula 1 analytics website powered by F1DB, Node.js and MySQL.",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "import": "node backend/import/all.js",
    "import:f2-results": "node scripts/import-f2-results.js",
    "import:f2-standings": "node scripts/import-f2-standings.js",
    "collect:f3": "node scripts/collect-f3-data.js",
    "collect:academy": "node scripts/collect-academy-data.js",
    "import:replay:telemetry": "python scripts/import-telemetry-replay.py",
    "audit:f3": "node scripts/audit-f3-data.js --series=f3",
    "audit:f2": "node scripts/audit-f3-data.js --series=f2",
    "audit:academy": "node scripts/audit-f3-data.js --series=academy",
    "repair:data": "node scripts/repair-f1-2026-calendar.js && node scripts/repair-junior-data.js",
    "check": "node scripts/check.js",
    "test": "node --test"
  },
  "dependencies": {
    "csv-parser": "^3.2.1",
    "d3": "^7.9.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mariadb": "^3.4.5",
    "playwright-core": "^1.62.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
